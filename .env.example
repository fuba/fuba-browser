# API Server Configuration
API_PORT=39000
# CORS is disabled by default. Set a comma-separated allowlist only when needed.
# API_CORS_ORIGINS=http://localhost:3000,https://example.com

# Chrome DevTools Configuration
DEVTOOLS_PORT=9222

# Optional browser override. The Docker image uses its pinned Chrome for Testing.
# Any override must satisfy the security baseline checked at startup.
# FUBA_BROWSER_EXECUTABLE_PATH=/opt/chrome/chrome

# Optional literal UA override. Derives Client Hints and navigator identity.
# Defaults to Windows Chrome matching the running Chromium major version.
# FUBA_BROWSER_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/156.0.0.0 Safari/537.36

# VNC Configuration (future)
VNC_ENABLED=false
VNC_PORT=5900

# Proxy Configuration (optional)
# PROXY_SERVER=http://localhost:13128
# PROXY_BYPASS=localhost,127.0.0.1

# Debug Mode
DEBUG=false

# Hardware GPU mode (off by default; use auto, nvidia, or amd)
# Auto mode requires exactly one supported vendor on the host.
FUBA_GPU_MODE=off
